{{- $pages := where .Pages "Type" "not in" (slice "projecte" "cronologia") -}}
{{- $pages = $pages.ByParam "publicat" | collections.Reverse -}}
{{- $limit := .Site.Config.Services.RSS.Limit -}}
{{- if ge $limit 1 -}}
  {{- $pages = $pages | first $limit -}}
{{- end -}}
{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss xmlns:atom="http://www.w3.org/2005/Atom" version="2.0">
  <channel>
    <title>{{ if eq .Title .Site.Title }}{{ .Site.Title }}{{ else }}{{ with .Title }}{{ . }} · {{ end }}{{ .Site.Title }}{{ end }}</title>
    <link>{{ .Permalink }}</link>
    <description>{{ .Site.Params.description }}</description>
    <generator>Hugo</generator>
    <language>{{ site.Language.Lang }}</language>
    {{ with .Site.Copyright }}<copyright>{{.}}</copyright>{{ end }}
    {{ if not .Date.IsZero }}<lastBuildDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</lastBuildDate>{{ end }}
    {{- with .OutputFormats.Get "RSS" }}
    <atom:link href="{{ .Permalink }}" rel="self" type="{{ .MediaType }}" />
    {{- end }}
    {{ range $pages }}
    <item>
      <title>{{ .Title | plainify | htmlEscape }}</title>
      <link>{{ .Permalink }}</link>
      {{- $pubData := .Params.publicat -}}
<pubDate>{{ if $pubData }}{{ (time.AsTime $pubData).Format "Mon, 02 Jan 2006 15:04:05 -0700" }}{{ else }}{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}{{ end }}</pubDate>
      <guid>{{ .Permalink }}</guid>
      <description>{{ with .Description }}{{ . | html }}{{ else }}{{ .Summary | html }}{{ end }}</description>
    </item>
    {{ end }}
  </channel>
</rss>